CTM_DATABASE_PATH=data/team.sqlite3
CTM_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Local HTTP only. Use true and HTTPS for remote access.
CTM_SECURE_COOKIES=false
CTM_SERVE_FRONTEND=false
CTM_SESSION_HOURS=24
CTM_INVITATION_HOURS=72
CTM_RESET_HOURS=1
CTM_FIT_PATH=data/fit
CTM_FIT_MAX_BYTES=33554432

# Optional approved OnelapFit gateway (HTTPS origin). Empty disables live requests.
CTM_ONELAP_GATEWAY=
CTM_ONELAP_KEYS=[]
CTM_ONELAP_VALIDATED=false
CTM_ONELAP_INTERVAL_SECONDS=900
CTM_ONELAP_HISTORY_DAYS=90
CTM_ONELAP_REQUEST_INTERVAL_SECONDS=1
